  return { lines, alerts };\n})"},{"value":1},{"value":{"o":[{"k":"maxAlerts","v":5},{"k":"maxAlertChars","v":200},{"k":"maxNodes","v":4000},{"k":"maxLines","v":400}],"id":1}}],"returnByValue":true,"awaitPromise":true,"userGesture":true},"sessionId":"08EBE0B3E48BCFDBE949C693DED421C1"}
