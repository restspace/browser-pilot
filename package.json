{
  "name": "sleep-walker",
  "version": "0.3.0",
  "description": "Sleep-walker: an agent-in-the-loop Playwright CLI that learns a flow once, then replays it with the model asleep \u2014 zero-LLM, deterministic, verified.",
  "keywords": [
    "playwright",
    "browser-automation",
    "llm-agent",
    "e2e-testing",
    "record-replay",
    "deterministic-replay",
    "cli"
  ],
  "homepage": "https://sleep-walker.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/restspace/sleep-walker.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "sleep-walker": "bin/browser-pilot.js",
    "browser-pilot": "bin/browser-pilot.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "playwright-core": "^1.53.0"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
